# =============================================================================
# 이어가 환경변수
# 이 파일을 .env.local로 복사한 뒤 값을 채웁니다. .env* 는 커밋되지 않습니다.
#   Copy-Item .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 필수 — 없으면 서비스가 동작하지 않습니다
# -----------------------------------------------------------------------------

# 공공데이터포털(data.go.kr) 마이페이지 → 인증키 발급현황 → 일반 인증키.
# 앱이 URL 인코딩을 직접 수행하므로 반드시 Decoding 형태를 넣습니다.
# (영문·숫자로만 이루어진 키는 두 형태가 동일합니다.)
# 미설정 시: /api/v1/health/ready 가 configured:false 와 함께 unavailable.
KTO_SERVICE_KEY=

# -----------------------------------------------------------------------------
# 2. 기능별 필수 — 해당 API를 쓸 때만 필요합니다
# -----------------------------------------------------------------------------

# /api/v1/partner/* 의 Bearer 토큰. 파트너 복구 API 데모에 사용합니다.
# 직접 만든 긴 임의값을 넣습니다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 미설정 시: 파트너 API가 503으로 비활성화됩니다.
PARTNER_API_KEY=

# /api/v1/ops/* 의 Bearer 토큰. 미션 상태 변경, 강제 동기화, OpenAPI 정밀
# 점검에 사용합니다. PARTNER_API_KEY 와 반드시 다른 값이어야 합니다.
# 미설정 시: 운영 제어 API가 503으로 비활성화됩니다.
OPS_API_KEY=

# -----------------------------------------------------------------------------
# 3. 선택 — 외부 제공자를 공개 공유에서 관리형으로 전환합니다
#    미설정 시에도 동작하지만 준비 상태가 degraded 로 남습니다.
# -----------------------------------------------------------------------------

# 카카오 REST API 키. 이 하나로 역지오코딩과 장소검색이 함께 관리형이 됩니다.
# developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# 역지오코딩은 coord2regioncode 의 법정동 코드를 공사 시도·시군구 코드로
# 직접 대응시키므로, 공개 Nominatim 의 이름 대조보다 정확합니다.
KAKAO_REST_API_KEY=

# 도보 경로. OSRM 호환 엔드포인트를 쉼표로 구분해 순서대로 시도합니다.
# 공개 제공자가 항상 마지막에 자동으로 덧붙습니다.
#   자체 운영 OSRM  : https://osrm.example.com/route/v1/foot
#   질의 인증 제공자 : https://api.mapbox.com/directions/v5/mapbox/walking?access_token=토큰
# 좌표는 경로(path)에 붙으므로 인증용 질의 문자열이 보존됩니다.
ROUTING_BASE_URL=

# 아래 둘은 KAKAO_REST_API_KEY 를 쓰지 않고 Nominatim 호환 엔드포인트를
# 직접 운영할 때만 채웁니다. 카카오 키가 있으면 설정할 필요가 없습니다.
REVERSE_GEOCODE_URL=
FORWARD_GEOCODE_URL=

# 기상청 단기예보 인증키. 설정하면 국내 공식 기상자료가 1순위가 되고
# Open-Meteo 는 장애 시 대체 경로로만 남습니다.
#
# 값은 data.go.kr 의 일반 인증키로 KTO_SERVICE_KEY 와 같은 문자열이지만,
# 여기에 다시 적어야 동작합니다. 자동으로 KTO 키를 빌려 쓰지 않습니다.
# 포털은 데이터셋별로 활용신청을 따로 받으므로, 승인받지 않은 계정이
# 자동 사용하면 날씨 조회마다 5초를 버리고 실패한 뒤 대체 경로로 넘어가고
# 준비 상태에는 응답하지도 않는 관리형 제공자가 표시되기 때문입니다.
#
# 활용신청: data.go.kr 에서 "기상청_단기예보 ((구)_동네예보) 조회서비스"
# 승인 전에는 403 Forbidden 이 반환되며, 이때는 Open-Meteo 로 대체됩니다.
KMA_SERVICE_KEY=

# 날씨 대체 제공자. Open-Meteo 와 응답 형식이 같은 엔드포인트만 동작합니다
# (current=temperature_2m,... / hourly=precipitation_probability 규약).
WEATHER_API_URL=
