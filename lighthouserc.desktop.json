{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 4194 --ip 127.0.0.1",
      "startServerReadyPattern": "Ready on http://127.0.0.1:4194",
      "url": [
        "http://127.0.0.1:4194/",
        "http://127.0.0.1:4194/flow",
        "http://127.0.0.1:4194/app",
        "http://127.0.0.1:4194/plan",
        "http://127.0.0.1:4194/policy",
        "http://127.0.0.1:4194/sources",
        "http://127.0.0.1:4194/embed/demo"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/embed/).*$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "color-contrast": "error",
            "document-title": "error",
            "html-has-lang": "error",
            "meta-description": "error",
            "viewport": "error"
          }
        },
        {
          "matchingUrlPattern": ".*/embed/.*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "color-contrast": "error",
            "document-title": "error",
            "html-has-lang": "error",
            "meta-description": "error",
            "viewport": "error",
            "is-crawlable": "off"
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop"
    }
  }
}
