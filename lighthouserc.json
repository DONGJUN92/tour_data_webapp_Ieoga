{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 4193 --ip 127.0.0.1",
      "startServerReadyPattern": "Ready on http://127.0.0.1:4193",
      "url": [
        "http://127.0.0.1:4193/",
        "http://127.0.0.1:4193/flow",
        "http://127.0.0.1:4193/app",
        "http://127.0.0.1:4193/plan"
      ],
      "numberOfRuns": 2,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 1,
          "disabled": false
        },
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "color-contrast": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "meta-description": "error",
        "viewport": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mobile"
    }
  }
}
