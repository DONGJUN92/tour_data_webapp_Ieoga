{
  "name": "ieoga-national-travel-resilience",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/sanitize-build.mjs",
    "start": "node scripts/start-production-local.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/rendered-html.test.mjs tests/policy-missions.test.mjs tests/persistence-atomicity.test.mjs tests/continuity-engine.test.mjs tests/place-search.test.mjs tests/simulation-guide.test.mjs tests/launch-evidence.test.mjs tests/kma-weather.test.mjs tests/kto-concurrency.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:baseline:legacy-local": "node scripts/baseline-legacy-local-d1.mjs",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --local"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-leaflet": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
