{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ieoga-national-travel-resilience",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/sw.js"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  /* `vars`는 여기에 두지 않는다. 배포는 `--strict`로 설정 파일과 원격 Worker를
     대조하는데, 이 블록이 비어 있으면 wrangler가 "이 파일은 vars에 관여하지
     않는다"로 보고 넘어가지만 한 줄이라도 적으면 **전체 집합을 선언한 것**이
     되어 원격에만 있는 값(`DEPLOYMENT_COMMIT_SHA`)과 충돌해 배포가 중단된다.

     공개 폴백 없음 선언은 릴리스 워크플로의 `--var`로 넘긴다. 커밋 SHA가 이미
     같은 방식으로 전달되고 있으므로 자리도 그쪽이 맞다. */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "c3e221ce-bfc2-4311-b032-73d9069fdbae",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REGION_PACKS",
      "bucket_name": "site-creator-r2"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
